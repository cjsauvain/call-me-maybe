[
  {
    "name": "fn_create_order",
    "description": "Create an order for a customer with a shipping address, a list of items with their quantity and unit price, an express flag and an optional coupon that can be null.",
    "parameters": {
      "order": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "age": {
                "type": "integer"
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "unit_price": {
                  "type": "number"
                }
              }
            }
          },
          "express": {
            "type": "boolean"
          },
          "coupon": {
            "type": "null"
          }
        }
      }
    },
    "returns": {
      "type": "string"
    }
  },
  {
    "name": "fn_configure_server",
    "description": "Configure a server with its hostname, network settings (port, timeout in seconds, TLS flag, optional proxy that can be null) and a list of allowed IP ranges.",
    "parameters": {
      "server": {
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string"
          },
          "network": {
            "type": "object",
            "properties": {
              "port": {
                "type": "integer"
              },
              "timeout": {
                "type": "number"
              },
              "tls": {
                "type": "boolean"
              },
              "proxy": {
                "type": "null"
              }
            }
          },
          "allowed_ranges": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "returns": {
      "type": "boolean"
    }
  }
]
